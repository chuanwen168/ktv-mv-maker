<Window x:Class="KTV_MV_maker.PlainTextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="解密后的 KRC 明文" Height="620" Width="860"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="txtInfo" Margin="0,0,0,6" Foreground="#555" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" x:Name="txtPlain" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" Background="#FCFCFC"/>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Width="88" Content="关闭" Click="BtnClose_Click" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Width="96" Content="另存为..." Click="BtnSaveAs_Click" Margin="6,0,0,0"
                    ToolTip="把解密后的明文另存为 .lrc 或 .txt 文件"/>
            <Button DockPanel.Dock="Right" Width="96" Content="复制全部" Click="BtnCopy_Click"
                    ToolTip="把全部明文复制到剪贴板"/>
            <TextBlock x:Name="txtCount" VerticalAlignment="Center" Foreground="#666"/>
        </DockPanel>
    </Grid>
</Window>
